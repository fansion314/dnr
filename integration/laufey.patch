+// Process-wide content zoom. Accessors intentionally do not call api(): merely
+// inspecting or configuring desktop defaults must not activate the GUI.
+struct DesktopZoom {
+  global: f64,
+  app: f64,
+  shortcuts: bool,
+  changed: Option<Box<dyn Fn(f64, f64, bool) + Send + Sync>>,
+}
+static DESKTOP_ZOOM: Mutex<DesktopZoom> = Mutex::new(DesktopZoom {
+  global: 1.0, app: 1.0, shortcuts: true, changed: None,
+});
+
+pub fn set_global_zoom(factor: f64) {
+  assert!(factor.is_finite() && (0.5..=2.0).contains(&factor));
+  assert!(!is_initialized(), "global zoom is a startup setting");
+  DESKTOP_ZOOM.lock().unwrap().global = factor;
+}
+pub fn desktop_zoom() -> [f64; 3] {
+  let state = DESKTOP_ZOOM.lock().unwrap();
+  [state.global, state.app, state.global * state.app]
+}
+pub fn on_zoom_change(handler: impl Fn(f64, f64, bool) + Send + Sync + 'static) {
+  DESKTOP_ZOOM.lock().unwrap().changed = Some(Box::new(handler));
+}
+pub fn zoom_shortcuts_enabled() -> bool {
+  DESKTOP_ZOOM.lock().unwrap().shortcuts
+}
+pub fn set_zoom_shortcuts_enabled(enabled: bool) {
+  DESKTOP_ZOOM.lock().unwrap().shortcuts = enabled;
+}
+fn change_zoom(state: &mut DesktopZoom, factor: f64, shortcut: bool) {
+  if state.app == factor { return; }
+  state.app = factor;
+  // The native setter only queues work; it must never reenter this controller.
+  // Serialize publication with state changes so UI tasks see the latest value.
+  if let Some(api) = try_api() {
+    if let Some(set) = api.set_content_zoom {
+      unsafe { set(api.backend_data, state.global * state.app); }
+    }
+  }
+  if let Some(changed) = &state.changed {
+    changed(state.global, state.app, shortcut);
+  }
+}
+pub fn set_desktop_zoom(factor: f64) -> Result<(), &'static str> {
+  if !factor.is_finite() || !(0.5..=2.0).contains(&factor) {
+    return Err("zoom factor must be a finite number between 0.5 and 2.0");
+  }
+  change_zoom(&mut DESKTOP_ZOOM.lock().unwrap(), factor, false);
+  Ok(())
+}
+unsafe extern "C" fn zoom_shortcut(action: c_int) -> bool {
+  let mut state = DESKTOP_ZOOM.lock().unwrap();
+  if !state.shortcuts { return false; }
+  let levels = [0.5, 0.67, 0.8, 0.9, 1.0, 1.1, 1.25, 1.5, 1.75, 2.0];
+  let factor = match action {
+    0 => return true,
+    1 => levels.into_iter().find(|v| *v > state.app + 1e-10).unwrap_or(2.0),
+    -1 => levels.into_iter().rev().find(|v| *v < state.app - 1e-10).unwrap_or(0.5),
+    2 => 1.0,
+    _ => return false,
+  };
+  change_zoom(&mut state, factor, true);
+  true
 }
 
