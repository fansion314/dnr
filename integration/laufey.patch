+static CefRefPtr<CefImage> DnrCefIcon(GdkPixbuf* source, int size) {
+  auto* scaled = gdk_pixbuf_scale_simple(source, size, size, GDK_INTERP_BILINEAR);
+  auto* rgba = gdk_pixbuf_add_alpha(scaled, FALSE, 0, 0, 0);
+  g_object_unref(scaled);
+  const auto* pixels = gdk_pixbuf_read_pixels(rgba);
+  const int stride = gdk_pixbuf_get_rowstride(rgba);
+  std::vector<unsigned char> packed(size * size * 4);
+  for (int y = 0; y < size; ++y)
+    std::copy_n(pixels + y * stride, size * 4, packed.data() + y * size * 4);
+  auto image = CefImage::CreateImage();
+  image->AddBitmap(1.0f, size, size, CEF_COLOR_TYPE_RGBA_8888,
+                   CEF_ALPHA_TYPE_POSTMULTIPLIED, packed.data(), packed.size());
+  g_object_unref(rgba);
+  return image;
+}
