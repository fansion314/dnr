+type SystemEventHandler = Box<dyn Fn(&str) + Send + Sync>;
+static SYSTEM_EVENT_HANDLER: Mutex<Option<SystemEventHandler>> = Mutex::new(None);
+static SYSTEM_MONITOR_ACTIVE: AtomicBool = AtomicBool::new(false);
+pub fn system_monitor_active() -> bool { SYSTEM_MONITOR_ACTIVE.load(Ordering::Acquire) }
+unsafe extern "C" fn system_event_callback(_data: *mut c_void, event: *const c_char) {
+  if event.is_null() { return; }
+  let Ok(event) = CStr::from_ptr(event).to_str() else { return; };
+  if !matches!(event, "lock" | "suspend" | "resume") { return; }
+  if let Some(handler) = SYSTEM_EVENT_HANDLER.lock().unwrap().as_ref() { handler(event); }
+}
+pub fn start_system_monitor(handler: impl Fn(&str) + Send + Sync + 'static) -> u32 {
+  *SYSTEM_EVENT_HANDLER.lock().unwrap() = Some(Box::new(handler));
+  let capabilities = api().set_system_monitor.map(|set| unsafe {
+    set(api().backend_data, Some(system_event_callback), std::ptr::null_mut())
+  }).unwrap_or(0);
+  SYSTEM_MONITOR_ACTIVE.store(capabilities != 0, Ordering::Release);
+  capabilities
+}
+pub fn stop_system_monitor() {
+  *SYSTEM_EVENT_HANDLER.lock().unwrap() = None;
+  if let Some(set) = api().set_system_monitor { unsafe { set(api().backend_data, None, std::ptr::null_mut()); } }
+  SYSTEM_MONITOR_ACTIVE.store(false, Ordering::Release);
+}
+pub fn system_idle_seconds() -> f64 {
+  api().system_idle_seconds.map(|get| unsafe { get(api().backend_data) }).unwrap_or(-1.0)
 }
 
