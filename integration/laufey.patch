+void WebKitGTKBackend::SetContentZoom() {
+  // Always enqueue, including when invoked by a native key callback. The Rust
+  // controller may still hold its lock while publishing the new factor.
+  g_idle_add_full(G_PRIORITY_DEFAULT, [](gpointer data) -> gboolean {
+    auto* self = static_cast<WebKitGTKBackend*>(data);
+    std::lock_guard<std::mutex> lock(self->windows_mutex_);
+    for (auto& [id, state] : self->windows_) {
+      if (!dnr_zoom_exempt.contains(id)) webkit_web_view_set_zoom_level(state.webview, DnrWindowZoom(id));
+    }
+    return G_SOURCE_REMOVE;
+  }, this, nullptr);
+}
+
 void WebKitGTKBackend::SetWindowOpacity(uint32_t window_id, double opacity) {
