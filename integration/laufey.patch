+void RuntimeLoader::CancelEvalCallbacks(uint32_t window_id,
+                                        const std::string& error) {
+  std::vector<PendingEval> cancelled;
+  {
+    std::lock_guard<std::mutex> lock(eval_mutex_);
+    for (auto it = pending_evals_.begin(); it != pending_evals_.end();) {
+      if (it->second.window_id == window_id) {
+        cancelled.push_back(it->second);
+        it = pending_evals_.erase(it);
+      } else {
+        ++it;
+      }
+    }
+  }
+  // Callbacks may re-enter the runtime; never invoke them under a native lock.
+  laufey_value error_value(laufey::Value::String(error));
+  for (const auto& eval : cancelled) {
+    eval.callback(nullptr, &error_value, eval.callback_data);
   }
 }
 
