+// Security-relevant OS transitions must survive saturation of the ordinary
+// mouse/keyboard queue. Coalesce states, prioritizing lock and suspend over resume.
+static PENDING_SYSTEM_STATES: std::sync::atomic::AtomicU8 = std::sync::atomic::AtomicU8::new(0);
+pub fn queue_system_state(state: &str) {
+  let bit = match state { "lock" => 1, "suspend" => 2, "resume" => 4, _ => return };
+  PENDING_SYSTEM_STATES.fetch_or(bit, std::sync::atomic::Ordering::Release);
+}
+pub fn clear_system_states() { PENDING_SYSTEM_STATES.store(0, std::sync::atomic::Ordering::Release); }
+fn take_system_state() -> Option<DesktopEvent> {
+  use std::sync::atomic::Ordering;
+  let mut pending = PENDING_SYSTEM_STATES.load(Ordering::Acquire);
+  while pending != 0 {
+    let bit = pending & pending.wrapping_neg();
+    match PENDING_SYSTEM_STATES.compare_exchange_weak(pending, pending & !bit, Ordering::AcqRel, Ordering::Acquire) {
+      Ok(_) => return Some(DesktopEvent::SystemState { state: match bit {1 => "lock", 2 => "suspend", _ => "resume"}.to_owned() }),
+      Err(value) => pending = value,
+    }
+  }
+  None
+}
