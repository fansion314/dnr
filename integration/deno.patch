+pub fn configure(js_runtime: &mut deno_core::JsRuntime, cache: Option<std::sync::Arc<dyn CodeCache>>) {
+    js_runtime
+      .set_eval_context_code_cache_cbs(cache.map(|cache| {
+      let cache_clone = cache.clone();
+      (
+        Box::new(move |specifier: &ModuleSpecifier, source: &[u16]| {
+          let source_hash = {
+            use std::hash::Hash;
+            use std::hash::Hasher;
+            let mut hasher = twox_hash::XxHash64::default();
+            source.hash(&mut hasher);
+            hasher.finish()
+          };
+          let data = cache
+            .get_sync(specifier, CodeCacheType::Script, source_hash)
+            .inspect(|_| {
+              // This log line is also used by tests.
+              log::debug!(
+                "V8 code cache hit for script: {specifier}, [{source_hash}]"
+              );
+            })
+            .map(std::borrow::Cow::Owned);
+          Ok(deno_core::SourceCodeCacheInfo {
+            data,
+            hash: source_hash,
+          })
+        }) as Box<dyn Fn(&_, &_) -> _>,
+        Box::new(
+          move |specifier: ModuleSpecifier, source_hash: u64, data: &[u8]| {
+            // This log line is also used by tests.
+            log::debug!(
+              "Updating V8 code cache for script: {specifier}, [{source_hash}]"
+            );
+            cache_clone.set_sync(
+              specifier,
+              CodeCacheType::Script,
+              source_hash,
+              data,
+            );
+          },
+        ) as Box<dyn Fn(_, _, &_)>,
+      )
+    }));
+
+}
