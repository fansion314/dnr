+
+  #[test]
+  fn numeric_exclusive_opens_preserve_existing_files() {
+    struct Cleanup(std::path::PathBuf);
+    impl Drop for Cleanup {
+      fn drop(&mut self) {
+        let _ = fs::remove_file(&self.0);
+      }
+    }
+    let path = Cleanup(std::env::temp_dir().join(format!(
+      "dnr-exclusive-{}-{}",
+      std::process::id(),
+      rand::random::<u64>()
+    )));
+    fs::OpenOptions::new()
+      .write(true)
+      .create_new(true)
+      .open(&path.0)
+      .unwrap();
+    fs::write(&path.0, b"preserve").unwrap();
+    for access in [libc::O_RDONLY, libc::O_WRONLY, libc::O_RDWR] {
+      drop(
+        open_options(OpenOptions::from(access | libc::O_EXCL))
+          .open(&path.0)
+          .unwrap(),
+      );
+    }
+    let error = open_options(OpenOptions::from(
+      libc::O_RDWR | libc::O_CREAT | libc::O_EXCL,
+    ))
+    .open(&path.0)
+    .unwrap_err();
+    assert_eq!(error.raw_os_error(), Some(libc::EEXIST));
+    assert_eq!(fs::read(&path.0).unwrap(), b"preserve");
+    fs::remove_file(&path.0).unwrap();
+    let error = open_options(OpenOptions::from(libc::O_RDWR | libc::O_EXCL))
+      .open(&path.0)
+      .unwrap_err();
+    assert_eq!(error.raw_os_error(), Some(libc::ENOENT));
+    drop(
+      open_options(OpenOptions::from(
+        libc::O_RDWR | libc::O_CREAT | libc::O_EXCL,
+      ))
+      .open(&path.0)
+      .unwrap(),
