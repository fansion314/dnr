pkgbase = dnr
	pkgdesc = Shared Deno runtime (system CEF + WebView)
	pkgver = 0.4.0
	pkgrel = 1
	url = https://github.com/fansion314/dnr
	arch = x86_64
	license = MIT
	license = Apache-2.0
	license = BSD-3-Clause
	makedepends = git
	makedepends = rust
	makedepends = clang
