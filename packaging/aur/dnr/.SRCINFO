	makedepends = python
	makedepends = pkgconf
	makedepends = cef
	makedepends = webkit2gtk-4.1
	makedepends = gtk3
	makedepends = glib2
	makedepends = cairo
	makedepends = libx11
	makedepends = libxi
	makedepends = libsoup3
	depends = glibc
	depends = gcc-libs
	depends = zlib
	optdepends = cef: system CEF desktop backend (also requires gtk3)
	optdepends = gtk3: native desktop UI for the CEF backend
	optdepends = webkit2gtk-4.1: WebView desktop backend (auto fallback)
	optdepends = libayatana-appindicator: system tray support
	optdepends = libnotify: desktop notifications via notify-send
	conflicts = dnr-bin
	conflicts = dnr-cef
	conflicts = dnr-cef-bin
	conflicts = dnr-webview
	conflicts = dnr-webview-bin
